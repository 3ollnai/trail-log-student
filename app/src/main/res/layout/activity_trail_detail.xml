<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
        <ImageView android:id="@+id/headerImage" android:layout_width="0dp" android:layout_height="160dp" android:src="@drawable/ic_mountain" android:background="@drawable/bg_trail_header" android:scaleType="centerInside" android:contentDescription="@null" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        <TextView android:id="@+id/titleText" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/headerImage" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/regionText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="4dp" app:layout_constraintTop_toBottomOf="@id/titleText" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/distanceText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:layout_constraintTop_toBottomOf="@id/regionText" app:layout_constraintStart_toStartOf="parent"/>
        <TextView android:id="@+id/elevationText" android:layout_width="wrap_content" android:layout_height="wrap_content" app:layout_constraintTop_toTopOf="@id/distanceText" app:layout_constraintEnd_toEndOf="parent"/>
        <fr.estiam.traillog.ui.ElevationCurveView android:id="@+id/elevationCurve" android:layout_width="0dp" android:layout_height="120dp" android:layout_marginTop="12dp" android:contentDescription="@string/profile" app:curveColor="@color/trail_green" app:curveStrokeWidth="3dp" app:layout_constraintTop_toBottomOf="@id/distanceText" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        <TextView android:id="@+id/notesText" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="14dp" app:layout_constraintTop_toBottomOf="@id/elevationCurve" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        <LinearLayout android:id="@+id/buttonRow" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" app:layout_constraintTop_toBottomOf="@id/notesText" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <Button android:id="@+id/editButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/edit" />
            <Button android:id="@+id/favoriteButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/favorite" />
        </LinearLayout>
        <LinearLayout android:id="@+id/secondaryActions" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/buttonRow" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <Button android:id="@+id/deleteButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/delete" />
            <Button android:id="@+id/shareButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/share" />
        </LinearLayout>
        <Button android:id="@+id/notifyButton" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/notify_test" app:layout_constraintTop_toBottomOf="@id/secondaryActions" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
